        <h2>Digital <span class="accent" style="font-style: italic;">access</span></h2>
        <p class="intake-step__lede">
          For each access we need, pick how you'd like to share it.
          <strong> We never collect raw passwords here.</strong>
          Skip anything that doesn't apply.
        </p>

        <div class="banner banner--info" style="margin-bottom: 1.5rem;">
          <strong>Four ways to grant access:</strong> add us as a delegate
          (preferred — no credentials change hands); share via 1Password / Bitwarden Send;
          schedule a 15-min screen-share to do it together; or skip and handle it yourself.
        </div>

        <div class="repeating-list" data-step5-categories>
          {visibleCredentialCategories.map((cat) => {
            const saved = credByType[cat.type] ?? {};
            return (
              <div class="repeating-card" data-credential-type={cat.type}>
                <div class="repeating-card__header">
                  <span><strong>{cat.label}</strong></span>
                  <span class="muted" style="font-size: 0.8rem; text-transform: none; letter-spacing: 0;">{cat.type}</span>
                </div>
                <p class="muted" style="font-size: 0.9rem; margin: 0 0 0.75rem;">{cat.description}</p>
                <div class="checkbox-list" style="gap: 0.4rem;">
                  {[
                    { v: 'delegate',         l: 'Add me/Aeolistings as a delegate (preferred)' },
                    { v: 'password_manager', l: 'Share via 1Password / Bitwarden Send / one-time link' },
                    { v: 'screen_share',     l: 'Schedule a 15-min screen-share' },
                    { v: 'skip',             l: "Skip — I'll handle this myself" },
                  ].map((opt) => (
                    <label>
                      <input
                        type="radio"
                        name={`cred-${cat.type}`}
                        value={opt.v}
                        data-credential-method={cat.type}
                        checked={saved.method === opt.v}
                      />
                      <span>{opt.l}</span>
                    </label>
                  ))}
                </div>
                <div class="field" style="margin-top: 0.75rem; margin-bottom: 0;">
                  <label class="field__label" style="font-size: 0.85rem;">Notes (optional)</label>
                  <textarea
                    data-credential-notes={cat.type}
                    placeholder="Anything we should know — never paste passwords here."
                    rows="2"
                  >{saved.notes ?? ''}</textarea>
                </div>
              </div>
            );
          })}
        </div>

        <div class="button-row">
          <button type="button" class="btn btn--ghost" data-action="back">← Back</button>
          <div class="button-row__spacer"></div>
          <button
            type="button"
            class="btn btn--primary"
            data-action="continue"
            data-from-step="5"
          >Continue →</button>
        </div>
      </section>

      {/* Step 6 — Service area */}
      <section
        class="intake-step"
        data-step="6"
        data-active={state.current_step === 6 ? 'true' : 'false'}
      >
