        </div>
      </section>

      {/* Step 7 — Voice & guardrails */}
      <section
        class="intake-step"
        data-step="7"
        data-active={state.current_step === 7 ? 'true' : 'false'}
      >
        <h2>Voice &amp; <span class="accent" style="font-style: italic;">guardrails</span></h2>
