        </div>

        <h3 style="margin-top: 1.5rem;">Quarterly strategy review</h3>
        <div class="checkbox-list">
          {[
            { v: 'video_call',     l: 'Video call' },
            { v: 'written_report', l: 'Written report' },
            { v: 'both',           l: 'Both' },
          ].map((opt) => (
            <label>
              <input type="radio" name="step9-quarterly" value={opt.v} checked={state.step9?.quarterly_review === opt.v} />
