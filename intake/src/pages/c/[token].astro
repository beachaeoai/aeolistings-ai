        <div class="repeating-list" data-step6-custom-cities></div>
        <button type="button" class="btn btn--ghost" data-action="add-custom-city">+ Add another city</button>

        <div class="button-row">
          <button type="button" class="btn btn--ghost" data-action="back">← Back</button>
          <div class="button-row__spacer"></div>
          <button
            type="button"
            class="btn btn--primary"
            data-action="continue"
            data-from-step="6"
