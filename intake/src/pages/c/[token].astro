        <h3 style="margin-top: 1.5rem;">Pricing publishability</h3>
        <div class="checkbox-list">
          {[
            { v: 'starting_at', l: 'OK to publish "starting at $X"' },
            { v: 'full_range',  l: 'OK to publish a full price range' },
