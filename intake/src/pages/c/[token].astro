        <div class="field">
          <label class="field__label">Review responses</label>
          <select data-step8-approvals="review_responses">
            <option value="">Choose one</option>
            {APPROVAL_MODE_OPTIONS_QUICK.map((o) => (
              <option value={o.value} selected={state.step8?.approvals?.review_responses === o.value}>{o.label}</option>
