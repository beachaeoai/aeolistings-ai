---
// Bare-domain landing — what someone sees if they hit intake.aeolistings.ai/
// without a magic-link token. Real clients land on /c/<token>; this page
// exists so a stray visitor (or a client whose link expired) has a path
// back to a fresh link.

import Page from '../layouts/Page.astro';
---

<Page title="Aeolistings client intake">
  <h1>Aeolistings <span class="accent">client intake</span></h1>
  <p>
    This form opens via a personalized link sent to your email after you sign
    your Aeolistings sales contract.
  </p>
  <p>
    Lost your link? Email <a href="mailto:intake@aeolistings.ai">intake@aeolistings.ai</a>
    and we'll send a new one.
  </p>
</Page>
