{
  "name": "aeolistings-intake",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Aeolistings client intake form — turns a signed contract into a structured asset/access package",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler pages dev ./dist --config ./wrangler.toml",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=aeolistings-intake",
    "astro": "astro",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply intake-db --local --config ./wrangler.toml",
    "db:migrate:remote": "wrangler d1 migrations apply intake-db --remote --config ./wrangler.toml",
    "db:query:local": "wrangler d1 execute intake-db --local --config ./wrangler.toml --command",
    "db:query:remote": "wrangler d1 execute intake-db --remote --config ./wrangler.toml --command"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "^11.0.0",
    "@astrojs/tailwind": "^5.1.0",
    "@notionhq/client": "^2.2.15",
    "astro": "^4.16.0",
    "resend": "^4.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "ulidx": "^2.4.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.80.0"
  }
}
